{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // `DOM` is needed even though these specs run in Node — `page.evaluate`
    // callback bodies are typechecked as in-browser code by the same file's
    // tsconfig (e.g. `document`, `getComputedStyle` inside
    // `tablet-grid.e2e.ts`/`mobile-floor.e2e.ts`).
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Type safety — declared explicitly rather than inherited from the
       compiler default: TS 5.x defaults `strict` to false while TS 6 defaults
       it to true, so any tool bundling TS 5.x (an editor bundling its own
       tsserver, for instance) typechecks this project non-strictly and reports
       errors `tsc -b` never sees. See `tsconfig.app.json` for a concrete
       example. */
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
