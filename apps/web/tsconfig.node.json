{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Type safety — declared explicitly rather than inherited from the
       compiler default: TS 5.x defaults `strict` to false while TS 6 defaults
       it to true, so any tool bundling TS 5.x (an editor bundling its own
       tsserver, for instance) typechecks this project non-strictly and reports
       errors `tsc -b` never sees. See `tsconfig.app.json` for a concrete
       example. */
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "api/**/*.ts"]
}
